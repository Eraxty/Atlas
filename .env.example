# copy to .env (git ignored). `just` loads it for every recipe.

# folder holding config.json, atlas.db and the logs.
# unset: `just run` / `cargo run` use the repo folder
# ATLAS_HOME=/Users/you/Documents/Atlas

# ssh host for `just build-remote*`
# ATLAS_REMOTE_HOST=me@linuxbox
# ATLAS_REMOTE_DIR=atlas-build
